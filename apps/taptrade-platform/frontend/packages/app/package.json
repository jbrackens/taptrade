{
  "name": "@taptrade-ui/app",
  "version": "0.34.1-build.4",
  "description": "Next.js React App - The Tap Trade UI",
  "scripts": {
    "bootstrap:locales": "node ./scripts/translations/generate.js",
    "dev": "next dev --webpack",
    "run-local:dev": "yarn watch & next dev --webpack",
    "build": "next build --webpack && ./scripts/check-no-upstream-leak.sh",
    "check:no-upstream-leak": "./scripts/check-no-upstream-leak.sh",
    "build:local": "env-cmd -f .env.local yarn build",
    "build:dev": "env-cmd -f .env.development yarn build",
    "build:stage": "env-cmd -f .env.staging yarn build",
    "build:prod": "env-cmd -f .env.production yarn build",
    "build:start": "yarn build && yarn start",
    "build:export": "yarn build && next export",
    "build:export:local": "env-cmd -f .env.local yarn build:export",
    "build:export:dev": "env-cmd -f .env.development yarn build:export",
    "build:export:stage": "env-cmd -f .env.staging yarn build:export",
    "build:export:prod": "env-cmd -f .env.production yarn build:export",
    "start": "next start",
    "start:dev": "env-cmd -f .env.development next start",
    "start:stage": "env-cmd -f .env.staging next start",
    "export": "yarn build && next export",
    "test": "tsx --test --test-reporter=tap app/__tests__/*.test.ts",
    "test:jest": "jest --passWithNoTests --logHeapUsage --maxWorkers=50% --config ./jest.config.js",
    "test:coverage": "jest --coverage --logHeapUsage --maxWorkers=50% --config ./jest.config.js",
    "test:smoke": "playwright test --config=./playwright.config.ts",
    "test:smoke:ui": "playwright test --config=./playwright.config.ts --ui",
    "typecheck": "./scripts/typecheck-scoped.sh",
    "typecheck:full": "tsc --noEmit",
    "watch": "node ./scripts/translations/watch.js"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@number-flow/react": "^0.6.1",
    "@phosphor-icons/react": "2.1.10",
    "@taptrade-ui/api-client": "1.0.0",
    "@taptrade-ui/utils": "0.23.1-build.1",
    "geist": "1.7.2",
    "i18next": "^23.7.0",
    "isomorphic-dompurify": "^2.16.0",
    "jsonwebtoken": "^9.0.0",
    "libphonenumber-js": "^1.9.20",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.9",
    "react-i18next": "^13.5.0",
    "react-redux": "^7.1.3",
    "sonner": "^2.0.7",
    "uuid": "^8.3.1",
    "vaul": "^1.1.2",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@reduxjs/toolkit": "^1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "24.0.23",
    "@types/jsonwebtoken": "^7.2.7",
    "@types/node": "^14.6.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/react-redux": "^7.1.9",
    "@types/uuid": "^8.3.0",
    "dom-accessibility-api": "^0.5.2",
    "i18next-hmr": "^1.6.0",
    "react-test-renderer": "19.2.4",
    "tailwindcss": "^4",
    "tsx": "4.21.0",
    "typescript": "5.3.3"
  },
  "serial-number": 188
}
