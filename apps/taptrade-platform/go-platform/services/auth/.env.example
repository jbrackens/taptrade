# ─────────────────────────────────────────────────────────────────────────
# Auth service environment — Tap Trade (port 18081)
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# Persistence
AUTH_STORE_MODE=db
AUTH_DB_DSN=postgres://predict:localdev@localhost:5434/predict?sslmode=disable
# AUTH_REDIS_URL=redis://localhost:6380/0   # multi-instance session/rate-limit backend (optional)

# Cookies & session
AUTH_COOKIE_SECURE=false                    # "false" ONLY for local HTTP dev; real deployments must be true
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_REFRESH_TTL_SECONDS=86400

# Where OAuth callbacks send the user after a successful login. Must be the
# public origin of the player app.
AUTH_FRONTEND_URL=http://localhost:3000

# ─── Social OAuth providers ──────────────────────────────────────────────
# Each provider stays OFF until its CLIENT_ID (TikTok: CLIENT_KEY) is set; the
# /api/v1/auth/oauth/<provider>/start route returns "not configured" otherwise.
#
# REDIRECT_URI must be registered verbatim in the provider console AND should
# resolve to the public, SAME-ORIGIN callback so the session cookies land on
# the player-app origin (locally: Next rewrites /api/v1/* -> gateway -> auth;
# in prod put auth behind the app domain). Example prod value:
#   https://app.taptrade.example/api/v1/auth/oauth/google/callback
#
# Email/verification support per provider (drives account linking):
#   Google, Discord        -> assert a VERIFIED email -> auto-link to an existing account
#   Facebook               -> returns email but NO verified claim -> treated as unverified,
#                             so it creates an isolated (facebook, subject) account (no auto-link)
#   X (Twitter), TikTok, Reddit -> NO email -> always isolated identity accounts

# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:18081/api/v1/auth/oauth/google/callback

# Facebook — https://developers.facebook.com/apps (Facebook Login)
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:18081/api/v1/auth/oauth/facebook/callback

# Discord — https://discord.com/developers/applications (OAuth2; scopes: identify email)
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:18081/api/v1/auth/oauth/discord/callback

# X / Twitter — https://developer.x.com (OAuth 2.0 + PKCE; does NOT return email)
TWITTER_OAUTH_CLIENT_ID=
TWITTER_OAUTH_CLIENT_SECRET=
TWITTER_OAUTH_REDIRECT_URI=http://localhost:18081/api/v1/auth/oauth/twitter/callback

# TikTok — https://developers.tiktok.com (Login Kit; uses CLIENT_KEY, not CLIENT_ID; no email)
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:18081/api/v1/auth/oauth/tiktok/callback

# Reddit — https://www.reddit.com/prefs/apps (type: web app; no email via API)
REDDIT_OAUTH_CLIENT_ID=
REDDIT_OAUTH_CLIENT_SECRET=
REDDIT_OAUTH_REDIRECT_URI=http://localhost:18081/api/v1/auth/oauth/reddit/callback
